# ==============================================================================
# RUMAH BUDAYA RATNA - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================
# Gunakan file ini sebagai template konfigurasi lingkungan.
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rumah_budaya_ratna

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_IS_PRODUCTION=false

# Vercel Blob Storage Token (Media & File Upload)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Google OAuth2 Authentication (Mobile & Web)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
